{
  "name": "@effectforge/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EffectForge Zod schemas for projects, layers, and parameters",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
