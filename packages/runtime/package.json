{
  "name": "@effectforge/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent EffectForge effect runtime",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effectforge/renderer-three": "workspace:*",
    "@effectforge/schema": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
